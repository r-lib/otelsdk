\code{examples/shiny-span-processor} directory of the installed otelsdk
package:

\if{html}{\out{<div class="sourceCode r">}}\preformatted{system.file(package = "otelsdk", "examples", "shiny-span-processor")
}\if{html}{\out{</div>}}
}
